#!/bin/bash
# 双击运行：启动民国小镇 AI 后端（保持终端窗口开启即可）
cd "$(dirname "$0")"
echo "=========================================="
echo " 民国小镇 AI 后端  http://127.0.0.1:8765"
echo " 玩游戏期间请保持本窗口开启"
echo "=========================================="
python3 ai_town_server.py
echo ""
echo "服务器已退出（窗口可关闭）"
read -n 1 -s -r -p "按任意键关闭..."
